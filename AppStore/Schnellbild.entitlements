<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The Mac App Store build (Scripts/build_app.sh with SCHNELLBILD_APPSTORE=1).
         App Sandbox: no network; folders the user chooses or drops
         (read and write: rename, trash, move), kept across launches as
         security-scoped bookmarks (FolderAccess); the Pictures, Movies and
         Downloads folders without asking. -->
    <key>com.apple.application-identifier</key>
    <string>87884AP46G.art.haushoppe.schnellbild</string>
    <key>com.apple.developer.team-identifier</key>
    <string>87884AP46G</string>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <key>com.apple.security.assets.pictures.read-write</key>
    <true/>
    <key>com.apple.security.assets.movies.read-write</key>
    <true/>
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
</dict>
</plist>
