		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld изображения</string>
			<key>many</key>
			<string>%lld изображений</string>
			<key>one</key>
			<string>%lld изображение</string>
			<key>other</key>
			<string>%lld изображения</string>
		</dict>
	</dict>
	<key>%lld results</key>
