		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>many</key>
			<string>%lld vidéos</string>
			<key>one</key>
			<string>%lld vidéo</string>
			<key>other</key>
			<string>%lld vidéos</string>
		</dict>
	</dict>
</dict>
</plist>
