			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>many</key>
			<string>%lld dossiers</string>
			<key>one</key>
			<string>%lld dossier</string>
			<key>other</key>
			<string>%lld dossiers</string>
		</dict>
	</dict>
