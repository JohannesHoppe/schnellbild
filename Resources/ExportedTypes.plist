<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The UI-test build's Info.plist is generated; this adds what Resources/Info.plist declares beyond the defaults -->
<plist version="1.0">
<dict>
    <!-- The app's own tile drags (TileDrag.type): only its own drop targets take them -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>art.haushoppe.schnellbild.tile</string>
            <key>UTTypeDescription</key>
            <string>Schnellbild tiles</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
        </dict>
    </array>
    <!-- Matroska and VOB have no system type; declared so QuickLook can hand them to the thumbnail extension (the identifiers VLC uses) -->
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.matroska.mkv</string>
            <key>UTTypeDescription</key>
            <string>Matroska video</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.movie</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>mkv</string>
                </array>
                <key>public.mime-type</key>
                <array>
                    <string>video/x-matroska</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.videolan.vob</string>
            <key>UTTypeDescription</key>
            <string>DVD video</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.video</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>vob</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
