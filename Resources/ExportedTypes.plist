<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The UI-test build's Info.plist is generated; this adds what Resources/Info.plist declares beyond the defaults -->
<plist version="1.0">
<dict>
    <!-- Use My Location in the distance sheet (also in InfoPlist.strings per language) -->
    <key>NSLocationUsageDescription</key>
    <string>Schnellbild uses your location only when you click Use My Location, to sort photos and videos by their distance from you. It stays on your Mac.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Schnellbild uses your location only when you click Use My Location, to sort photos and videos by their distance from you. It stays on your Mac.</string>
    <!-- The app's own tile drags (TileDrag.type): only its own drop targets take them -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>art.haushoppe.schnellbild.tile</string>
            <key>UTTypeDescription</key>
            <string>Schnellbild tiles</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
        </dict>
        <!-- A row dragged within the slideshow's playlist (PlaylistPanel.dragType): only the playlist takes it -->
        <dict>
            <key>UTTypeIdentifier</key>
            <string>art.haushoppe.schnellbild.playlist-item</string>
            <key>UTTypeDescription</key>
            <string>Schnellbild playlist items</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
        </dict>
    </array>
    <!-- Matroska and VOB have no system type (the identifiers VLC uses), nor do downloads not finished ("x.mp4.part"); declared so QuickLook can hand them to the thumbnail extension -->
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.matroska.mkv</string>
            <key>UTTypeDescription</key>
            <string>Matroska video</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.movie</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>mkv</string>
                </array>
                <key>public.mime-type</key>
                <array>
                    <string>video/x-matroska</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.videolan.vob</string>
            <key>UTTypeDescription</key>
            <string>DVD video</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.video</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>vob</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
            <key>UTTypeDescription</key>
            <string>Download not finished</string>
            <key>UTTypeIdentifier</key>
            <string>art.haushoppe.schnellbild.download-in-progress</string>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>part</string>
                    <string>partial</string>
                    <string>crdownload</string>
                    <string>opdownload</string>
                    <string>!qB</string>
                    <string>!ut</string>
                    <string>!bt</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
