# The globe's data: where it comes from and which files it gives. Read by
# Scripts/build_globe_data.py (makes the files) and Scripts/fetch_globe.sh
# (downloads them for every build, checked by SHA-256).
# Plain KEY=value lines, no quoting, no spaces around "=".

# Elevation and ocean depth: NOAA's ETOPO 2022 (30 arc-second surface
# elevation, CC0 1.0), read through NOAA's OPeNDAP server, every fifth
# sample, averaged in blocks of 3 × 3 into cells of 1/8 degree
ETOPO_DAP_URL=https://www.ngdc.noaa.gov/thredds/dodsC/global/ETOPO2022/30s/30s_surface_elev_netcdf/ETOPO_2022_v1_30s_N90W180_surface.nc
# The server's answers for the eight bands (etopo-band-0.dods to -7.dods), in order
ETOPO_BANDS_SHA256=53b4b766851094e72702fa27fce9f14cf527227dbf8bb37083177bcf141cff41,db173b6af523743b66b0d86830cb8f2ad96c8bc42c1c34292198c47c35760209,aad9065bf9ffaebb1d73297be849cbf4bbd9afef0a66435e055fadda8fef1e76,dc88ab807abd93babb816a84a1feeb6b91c60463e549f3ba4fd450cd08255610,34162b7c6d32133cd9b25ac3afa3faefdc944a37da9a4a02fbd92b214f478b14,02863aef3342a74d28718fe8deaa16863063f3d81049d06750c4187295b00572,3a155535bc855ae53f54c9a6b877deef470b471fd012326aac402d4a7ad5a945,9660d78722455d8026818691f6c2492bcef590d6f95c60b672e16df7b2ee3c8e

# The night sky: NASA SVS "Deep Star Maps 2020" (svs.gsfc.nasa.gov/4851,
# public domain), the 4k star map in right ascension and declination
SKY_URL=https://svs.gsfc.nasa.gov/vis/a000000/a004800/a004851/starmap_2020_4k.exr
SKY_SIZE=35997085
SKY_SHA256=69b841cd048c2ef35543eb1c5819b322530e78aa4b0cab97ec1de3ef56a4ddcd
# The sky's JPEG quality (IJG's scale): 94 keeps it as large as ImageIO's at
# 0.9 (4 MB) with the same fidelity (PSNR 39.6 dB against the tone-mapped picture)
SKY_QUALITY=94

# The lights of the night side: NASA Earth Observatory's Black Marble 2016,
# grey, 3 km (13500 × 6750; the GeoTIFF, LZW, which the script reads itself), reduced for the globe
LIGHTS_URL=https://assets.science.nasa.gov/content/dam/science/esd/eo/images/imagerecords/144000/144897/BlackMarble_2016_3km_gray_geo.tif
LIGHTS_SHA256=3c1bc09978fa6a7f2c65453460fbd290b66441389f1135c111d699816b59b926
LIGHTS_WIDTH=5400

# The ground by day: NASA Earth Observatory's Blue Marble Next Generation,
# July 2004 without topography (the globe shades the relief itself), the
# 21600 × 10800 GeoTIFF (Deflate), in tiles of three levels
BLUEMARBLE_URL=https://assets.science.nasa.gov/content/dam/science/esd/eo/images/bmng/bmng-base/july/world.200407.3x21600x10800_geo.tif
BLUEMARBLE_SHA256=d62169a964372651791dc7e8d447a2ed8d9dafff703f326faca9ec501ac21a8c
SATELLITE_QUALITY=85

# The clouds: NASA's Blue Marble (2002) cloud picture, 2048 × 1024
CLOUD_PICTURE_URL=https://assets.science.nasa.gov/content/dam/science/esd/eo/content-feature/bluemarble/images/cloud_combined_2048.jpg
CLOUD_PICTURE_SHA256=daddaad84d7a33bbbc86cdda3f591099f57cee8607b7bcf3b67eb7e4f7a1c793
CLOUDS_QUALITY=88

# The archive of these inputs: assets of the pre-release SOURCE_RELEASE_TAG of
# this repository (never latest), the eight ETOPO bands and both pictures under
# their own names, each pinned above. build_globe_data.py takes them from there
# first; `--upstream --extract DIR` makes them anew from the sources above.
SOURCE_RELEASE_TAG=globe-source-20261115

# The files the pipeline gives (published as assets of the GitHub release
# RELEASE_TAG of this repository, pre-release, never latest)
RELEASE_TAG=globe-20261116
HEIGHTMAP_FILE=schnellbild-heightmap-20261116.sbhm
HEIGHTMAP_SHA256=f03bc92b6430754589cc18b83a031caf5a740c545ef93fabb1c8e8b25bcb9aa0
SKYMAP_FILE=schnellbild-sky-20261116.jpg
SKYMAP_SHA256=b27e1a41691f60cdf4e6aefe4252fc8f02e34b7958faa01203ab9a0dfcf81659
CITYLIGHTS_FILE=schnellbild-citylights-20261116.png
CITYLIGHTS_SHA256=9dfd0d7626d7ca962813bd1439a713f59b7cbbd14f05dd1883128dfa3317cae7
CLOUDS_FILE=schnellbild-clouds-20261116.jpg
CLOUDS_SHA256=a9c6892129c94037057775e49d1251573fa1bce8d0aea8fb365f633d1228a9a8
SATELLITE_FILE=schnellbild-satellite-20261116.bin
SATELLITE_SHA256=1a43487367de79192229c1347afc7fee82317956aead4988dd901a235b3f1b6a
NOTICE_FILE=schnellbild-globe-20261116-NOTICE.txt
