From aa411f1f56472564eed3723dfc089730263e1dfd Mon Sep 17 00:00:00 2001
From: Schnellbild build <build@schnellbild.invalid>
Date: Thu, 12 Nov 2026 08:10:25 +0100
Subject: [PATCH] contrib: zlib: build with the macOS 26 SDK

---
 contrib/src/zlib/rules.mak | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/contrib/src/zlib/rules.mak b/contrib/src/zlib/rules.mak
index 4dfd37a..1c64822 100644
--- a/contrib/src/zlib/rules.mak
+++ b/contrib/src/zlib/rules.mak
@@ -21,6 +21,9 @@ $(TARBALLS)/zlib-$(ZLIB_VERSION).tar.xz:
 zlib: zlib-$(ZLIB_VERSION).tar.xz .sum-zlib
 	$(UNPACK)
 	$(APPLY) $(SRC)/zlib/no-shared.patch
+	# Apple's SDKs from macOS 26 declare fdopen in _stdio.h; zlib 1.2.13 defines
+	# it away for TARGET_OS_MAC (zlib 1.3.1 no longer does)
+	sed -i.orig -e 's/defined(MACOS) || defined(TARGET_OS_MAC)/defined(MACOS)/' $(UNPACK_DIR)/zutil.h
 	$(MOVE)
 
 .zlib: zlib
-- 
