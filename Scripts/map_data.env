# The bundled offline map: which source build it is made from and which
# files it gives. Read by Scripts/build_map_data.py (makes the files) and
# Scripts/fetch_map.sh (downloads them for every build, checked by SHA-256).
# Plain KEY=value lines, no quoting, no spaces around "=".

# Protomaps' daily OpenStreetMap build (https://maps.protomaps.com/builds/),
# its size and its first 16 KiB (header and root directory) as checks that
# the source is the same file
PROTOMAPS_BUILD=20261114
PROTOMAPS_URL=https://build.protomaps.com/20261114.pmtiles
PROTOMAPS_SIZE=139488191421
PROTOMAPS_HEAD_SHA256=ce0092b7527ba0d7ce489b691a5ae36643f9da5eb97b38b905a78a00c57ae054

# Natural Earth's countries as Germany sees them (public domain; Natural Earth's
# default shows de facto borders), only to give each place its country code
NATURAL_EARTH_URL=https://naciscdn.org/naturalearth/10m/cultural/ne_10m_admin_0_countries_deu.zip
NATURAL_EARTH_SHA256=125fc4b1f425926b8bd22dce23af6f9f873543c2fe330915ccbe0aa7fa21ff82
# Natural Earth's disputed areas (public domain): the regions of the political overrides
# (build_map_data.py, REGION_COUNTRIES)
NATURAL_EARTH_DISPUTED_URL=https://naciscdn.org/naturalearth/10m/cultural/ne_10m_admin_0_disputed_areas.zip
NATURAL_EARTH_DISPUTED_SHA256=a250c1cf8ab68898399928a1fa1d5c242eb4de6335cb51a7f7a7f12a9f3c8438

# What the map holds: geometry up to this zoom, places from the tiles up to
# PLACES_ZOOM (they carry every place up to min_zoom PLACES_ZOOM + 1)
MAP_MAX_ZOOM=7
PLACES_ZOOM=10

# The files the pipeline gives (published as assets of the GitHub release
# RELEASE_TAG of this repository, pre-release, never latest)
RELEASE_TAG=map-20261114b
MAP_FILE=schnellbild-map-20261114b.pmtiles
MAP_SHA256=1998ba59173842bddbef976347d400d37a5c30a874bbdb33a1f7cd48511420a9
PLACES_FILE=schnellbild-places-20261114b.bin
PLACES_SHA256=3e3784760b13a3fc67bce3adb09370622c0547626e22d3bf59de2f3ba4c21a14
NOTICE_FILE=schnellbild-map-20261114b-NOTICE.txt
