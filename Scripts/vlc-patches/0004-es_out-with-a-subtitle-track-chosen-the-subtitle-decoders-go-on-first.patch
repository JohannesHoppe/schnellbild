es_out: with a subtitle track chosen, the subtitle decoders go on first

When the buffering ends VLC lets every decoder go on at once; the video's
first picture was now and then shown before the subtitle decoder, released
in the same moment, had handed its line to the video output (seen in one
run of thirty). With a subtitle track chosen at the start (sub-track-id) and
a video, the subtitle decoders are released first and the others 10 ms
later. Applied after 0003, with patch -p1 (Scripts/build_vlckit_lgpl.sh).

diff --git a/src/input/es_out.c b/src/input/es_out.c
--- a/src/input/es_out.c
+++ b/src/input/es_out.c
@@ -727,7 +727,8 @@
      * decoder, busy with a block it was given, finishes it first, so the
      * line it holds reaches the first picture (an idle one with nothing to
      * decode doesn't hold the start) */
-    if( b_video && var_GetInteger( p_sys->p_input, "sub-track-id" ) >= 0 )
+    const bool b_spu_first = b_video && var_GetInteger( p_sys->p_input, "sub-track-id" ) >= 0;
+    if( b_spu_first )
     {
         for( int i = 0; i < p_sys->i_es; i++ )
         {
@@ -749,12 +750,33 @@
 
     input_clock_ChangeSystemOrigin( p_sys->p_pgrm->p_clock, true,
                                     i_current_date + i_wakeup_delay - i_buffering_duration );
+
+    /* The subtitle decoders go on first, a moment ahead of the video, so the
+     * line they hold is with the video output before the first picture is
+     * shown (released together, the first picture won now and then) */
+    if( b_spu_first )
+    {
+        bool b_spu = false;
+        for( int i = 0; i < p_sys->i_es; i++ )
+        {
+            es_out_id_t *p_es = p_sys->es[i];
+            if( p_es->p_dec && p_es->fmt.i_cat == SPU_ES )
+            {
+                input_DecoderStopWait( p_es->p_dec );
+                if( p_es->p_dec_record )
+                    input_DecoderStopWait( p_es->p_dec_record );
+                b_spu = true;
+            }
+        }
+        if( b_spu )
+            msleep( 10 * 1000 );
+    }
 
     for( int i = 0; i < p_sys->i_es; i++ )
     {
         es_out_id_t *p_es = p_sys->es[i];
 
-        if( !p_es->p_dec )
+        if( !p_es->p_dec || ( b_spu_first && p_es->fmt.i_cat == SPU_ES ) )
             continue;
 
         input_DecoderStopWait( p_es->p_dec );
