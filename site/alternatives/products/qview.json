 "engine": "Qt 6 (QImageReader, KImageFormats plugins)",
 "category": "image",
 "summary": "qView is a minimal, cross-platform image viewer with no toolbars: it opens a single file and lets you page through the rest of the folder. It starts fast, preloads neighbouring images and supports animated images and many formats via Qt plugins. It is a good pick for people who only want a clean viewer.",
 "where_it_wins": [
  "Extremely minimal, chrome-less window",
  "Runs on Windows and Linux too, and on older macOS (10.13+ legacy build)",
  "Animated image frame stepping and speed control",
  "Open an image straight from a URL"
 ],
 "where_schnellbild_wins": [
  "Thumbnail grid, list view and folder browsing with search through subfolders",
  "Plays videos (incl. MKV/WebM/AVI via VLC) next to photos in one grid",
  "Archives and comics open as folders",
  "Camera RAW and PDF",
  "File management: move, copy, two panes, undo",
  "App Sandbox without network access",
  "Slideshow through all subfolders with photos and videos"
 ],
