 "summary": "Simple Comic is a lean, native macOS comic viewer focused on reading with as few interactions as possible. It opens CBZ/CBR/CB7, PDF and folders of images as a book, with two-page spreads, right-to-left manga order and Live Text on comic pages.",
 "where_it_wins": [
  "Two-page spreads and right-to-left manga mode",
  "Live Text: select, copy and speak text in comic pages",
  "Multi-volume RAR and nested archives open as one comic",
  "PDF reading",
  "Quick Look thumbnails for comic archives in Finder"
 ],
 "where_schnellbild_wins": [
  "Plays videos (MP4, MKV, WebM, AVI) next to images",
  "Browses whole folder trees with a thumbnail grid and list view",
  "File actions: rename, move, copy, trash with undo, two panes",
  "Slideshow through subfolders",
  "Your own keyboard shortcuts and light/dark setting",
  "Search names through all subfolders"
 ],
