 "category": "image",
 "summary": "PicView is a fast, free, open-source picture viewer for Windows and macOS built with Avalonia. It reads virtually every image format via Magick.NET, opens comics and archives, and adds a gallery, tabs, crop, batch resize and an image info window. Highly customisable, including key bindings.",
 "where_it_wins": [
  "Very broad image format support (Magick.NET)",
  "Crop, resize, convert and batch resize built in",
  "Tabs with per-tab history",
  "Side-by-side two-image view",
  "Edit EXIF rating and keywords",
  "Also on Windows"
 ],
 "where_schnellbild_wins": [
  "Plays videos (MP4/MOV, MKV/WebM/AVI via VLC) next to photos",
  "Folder browser with thumbnail grid, folder previews and list view",
  "Password-protected and multi-part archives, videos inside archives",
  "Two-pane file manager with undo",
  "App Sandbox and no network access",
  "Slideshow through all subfolders mixing photos and videos"
 ],
