    <string>87884AP46G.art.haushoppe.schnellbild.thumbnails</string>
    <key>com.apple.developer.team-identifier</key>
    <string>87884AP46G</string>
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
