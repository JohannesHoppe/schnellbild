{
  "name": "Schnellbild",
  "short_name": "Schnellbild",
  "description": "Fast, free image viewer and MKV player for Mac: thumbnails, keyboard paging, MKV, AVI and WebM, ZIP and RAR as folders. A Phiewer, XnView and IrfanView alternative.",
  "lang": "en",
  "start_url": "/",
  "display": "browser",
  "theme_color": "#fbfbfd",
  "background_color": "#fbfbfd",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
